@page "/badges"
@rendermode InteractiveServer
@inject IBadgesDAL BadgesDAL
@inject NavigationManager Navigation

<PageTitle>Badges</PageTitle>
<h1>Badges</h1>
<p>Here you can view and manage your badges.</p>

<BadgeList Items="badges" OnEdit="EditBadge" OnView="ViewBadge" OnDelete="RequestDelete" />

<button type="button" class="btn btn-success mt-3" @onclick="CreateBadge">Create New Badge</button>

@if (badgeToDelete is not null)
{
    <div class="alert alert-warning mt-3" role="alert">
        <p>Delete <strong>@badgeToDelete.Title</strong>?</p>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Confirm Delete</button>
        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel Delete</button>
    </div>
}

<BadgeDetails SelectedBadge="selectedBadge" />

@code {
    private List<Badge>? badges;
    private Badge? selectedBadge;
    private Badge? badgeToDelete;

    protected override async Task OnInitializedAsync()
    {
        badges = await BadgesDAL.GetBadgesAsync();
    }

    private void CreateBadge() => Navigation.NavigateTo("/badge-edit");

    private void EditBadge(Guid id) => Navigation.NavigateTo($"/badge-edit/{id}");

    private void ViewBadge(Badge badge) => selectedBadge = badge;

    private void RequestDelete(Badge badge) => badgeToDelete = badge;

    private async Task ConfirmDelete()
    {
        if (badgeToDelete is not Badge badge)
        {
            return;
        }

        CancelDelete();
        await BadgesDAL.DeleteBadgeAsync(badge.Id);
        badges = await BadgesDAL.GetBadgesAsync();

        if (selectedBadge?.Id == badge.Id)
        {
            selectedBadge = null;
        }
    }

    private void CancelDelete() => badgeToDelete = null;
}
