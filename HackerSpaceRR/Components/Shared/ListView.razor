@typeparam TModel

@if (Items.Count == 0)
{
    <p>No entries yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var item in Items)
        {
            <li class="list-group-item">@ItemTemplate(item)</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TModel> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TModel> ItemTemplate { get; set; } = default!;
}
